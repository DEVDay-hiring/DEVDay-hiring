# .env.local로 복사해 설정합니다. API 키는 서버에서만 읽습니다.
# VITE_ 접두사를 API 키에 붙이지 마세요.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# 내 OpenAI 계정에서 자료를 업로드한 Vector Store ID
# 비워두면 자료 검색 시 설정 안내를 반환합니다. 일반 대화는 가능합니다.
OPENAI_VECTOR_STORE_ID=
OPENAI_EVALUATION_MODEL=gpt-audio
OPENAI_EVALUATION_TEXT_MODEL=gpt-4.1-mini
# 비워두면 개발은 5174, 빌드 실행은 3001 포트를 사용합니다.
PORT=

# Vercel은 생성된 배포/프로젝트 도메인을 자동 허용합니다.
# 별칭·커스텀 도메인을 쓰거나 시스템 환경변수를 비활성화했다면 지정하세요.
APP_ORIGIN=https://frontend-web-pied-six.vercel.app
