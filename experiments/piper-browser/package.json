{
  "name": "hiring-piper-browser-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1 --port 5192 --strictPort",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5192 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
